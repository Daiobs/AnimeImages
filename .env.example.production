DJANGO_ENV=production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CACHE_URL=redis://username:password@redis-host:6379/0
DJANGO_CACHE_KEY_PREFIX=xhs_download_production
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

XHS_ALLOW_SERVER_SAVE=False
XHS_ALLOW_ABSOLUTE_SAVE_PATH=False
XHS_DEFAULT_SERVER_SAVE_DIR=xhs

DOWNLOAD_ASYNC_TASKS_ENABLED=False
DOWNLOAD_TRUST_X_FORWARDED_FOR=False
DOWNLOAD_RATE_LIMIT_PER_MINUTE=6
DOWNLOAD_DAILY_REQUEST_LIMIT_PER_IP=100
DOWNLOAD_GLOBAL_DAILY_REQUEST_LIMIT=1000
DOWNLOAD_MAX_CONCURRENT_PER_IP=1
DOWNLOAD_DAILY_BYTES_LIMIT_PER_IP=5368709120
DOWNLOAD_GLOBAL_DAILY_BYTES_LIMIT=107374182400

PREVIEW_RATE_LIMIT_PER_MINUTE=60
PREVIEW_DAILY_REQUEST_LIMIT_PER_IP=1000
PREVIEW_GLOBAL_DAILY_REQUEST_LIMIT=10000
PREVIEW_DAILY_BYTES_LIMIT_PER_IP=1073741824
PREVIEW_GLOBAL_DAILY_BYTES_LIMIT=21474836480

ULTRA_HD_PROVIDER_ENABLED=False
ULTRA_HD_PUBLIC_ACCESS_ENABLED=False
ULTRA_HD_RATE_LIMIT_PER_MINUTE=2
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_CHINA_BASE_URL=https://api.tikhub.dev
TIKHUB_REGION=CN
TIKHUB_DEFAULT_COUNTRY_CODE=CN
TIKHUB_TRUST_COUNTRY_HEADER=False
TIKHUB_COUNTRY_HEADER=HTTP_CF_IPCOUNTRY
TIKHUB_GEOIP_DATABASE_PATH=
TIKHUB_DAILY_LIMIT=20
DOUYIN_ULTRA_TOTAL_TIMEOUT_SECONDS=15.0
DOUYIN_ULTRA_NATIVE_TIMEOUT_SECONDS=5.0
DOUYIN_SHORT_LINK_TIMEOUT_SECONDS=2.0
DOUYIN_SHORT_LINK_MAX_REDIRECTS=4
TIKHUB_CONNECT_TIMEOUT_SECONDS=1.0
TIKHUB_READ_TIMEOUT_SECONDS=6.5
TIKHUB_MAX_ATTEMPTS=2
TIKHUB_PROBE_TIMEOUT_SECONDS=1.8
TIKHUB_MAX_PROBE_CANDIDATES=1
TIKHUB_VALIDATED_CACHE_TTL_SECONDS=600
DOUYIN_PROVIDER_ORDER=tikhub,native
XHS_PROVIDER_ORDER=native
