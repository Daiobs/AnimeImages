DJANGO_ENV=local
DJANGO_SECRET_KEY=django-insecure-local-dev-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CACHE_URL=
DJANGO_CACHE_KEY_PREFIX=xhs_download_local
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# APP_STATIC_VERSION=20260605

XHS_ALLOW_SERVER_SAVE=True
XHS_ALLOW_ABSOLUTE_SAVE_PATH=True
XHS_DEFAULT_SERVER_SAVE_DIR=xhs

DOWNLOAD_ASYNC_TASKS_ENABLED=True
DOWNLOAD_TRUST_X_FORWARDED_FOR=False
DOWNLOAD_RATE_LIMIT_PER_MINUTE=0
DOWNLOAD_DAILY_REQUEST_LIMIT_PER_IP=0
DOWNLOAD_GLOBAL_DAILY_REQUEST_LIMIT=0
DOWNLOAD_MAX_CONCURRENT_PER_IP=0
DOWNLOAD_DAILY_BYTES_LIMIT_PER_IP=0
DOWNLOAD_GLOBAL_DAILY_BYTES_LIMIT=0

PREVIEW_RATE_LIMIT_PER_MINUTE=0
PREVIEW_DAILY_REQUEST_LIMIT_PER_IP=0
PREVIEW_GLOBAL_DAILY_REQUEST_LIMIT=0
PREVIEW_DAILY_BYTES_LIMIT_PER_IP=0
PREVIEW_GLOBAL_DAILY_BYTES_LIMIT=0

ULTRA_HD_PROVIDER_ENABLED=False
ULTRA_HD_PUBLIC_ACCESS_ENABLED=True
ULTRA_HD_RATE_LIMIT_PER_MINUTE=0
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_REGION=CN
TIKHUB_CACHE_TTL_SECONDS=1800
TIKHUB_DAILY_LIMIT=20
DOUYIN_PROVIDER_ORDER=tikhub,native_enhanced,native
XHS_PROVIDER_ORDER=native
