{
  "title": "AnimeImages Rich Media Domain Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "post_type",
    "assets",
    "groups",
    "content_blocks"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "post_type": {
      "enum": ["image", "video", "gallery", "live_photo", "multimedia", "rich_text"]
    },
    "assets": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/asset"}
    },
    "groups": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/group"}
    },
    "content_blocks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/textBlock"},
          {"$ref": "#/$defs/mediaBlock"}
        ]
      }
    }
  },
  "$defs": {
    "domainId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]{0,31}(?::[a-z0-9][a-z0-9_-]{0,31}){1,5}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "media_type", "extension", "role"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/domainId"},
        "media_type": {"enum": ["image", "video"]},
        "extension": {"enum": ["jpg", "jpeg", "png", "gif", "webp", "avif", "mp4", "mov", "m3u8"]},
        "role": {"enum": ["primary", "gallery", "inline", "still", "motion", "animation"]}
      }
    },
    "groupMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "role"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/domainId"},
        "role": {"enum": ["still", "motion"]}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "relationship_type", "members"],
      "properties": {
        "group_id": {"$ref": "#/$defs/domainId"},
        "relationship_type": {"const": "live_photo"},
        "members": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/groupMember"}
        }
      }
    },
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {"const": "text"},
        "text": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "mediaBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "asset_ids"],
      "properties": {
        "type": {"const": "media"},
        "asset_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/domainId"}
        }
      }
    }
  }
}
